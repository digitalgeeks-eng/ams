PORT=5000

# Local MongoDB (keep commented if you are using Atlas only)
# MONGO_URI=mongodb://localhost:27017/fulafia-ams

# Online Atlas connection string (use this for hosting)
MONGO_URI=mongodb+srv://<your-username>:<your-password>@<your-cluster>.mongodb.net/fulafia-ams?appName=Cluster0

JWT_SECRET=replace_with_strong_secret
CLIENT_URL=http://localhost:5173
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
